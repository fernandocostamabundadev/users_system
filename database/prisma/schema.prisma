//============================================
// 1 configurando o gerador do prisma client
//============================================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//============================================
// 2 enums
//============================================
//===========status da conta==================
enum userStatus {
  ACTIVE
  INACTIVE
  BANNED
}

//=============papel do usuário=========================
enum userRole {
  USER
  ADMIN
}
